{
  "name": "yt-flotante",
  "productName": "YT Flotante",
  "version": "2.0.4",
  "description": "Ventana flotante para YouTube y cualquier video de Chrome que se aparta sola cuando haces clic donde está.",
  "main": "src/main.js",
  "author": "Felipe Álvarez",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.ytflotante",
    "productName": "YT Flotante",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "YT Flotante",
        "schemes": [
          "ytpip"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "YT-Flotante-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "YT-Flotante-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "trippyp98",
        "repo": "yt-flotante"
      }
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ]
  }
}
